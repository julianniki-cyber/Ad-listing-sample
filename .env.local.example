# Supabase — from Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — Project Settings > API > service_role (secret!).
# Used only in server-only code (lib/supabase/admin.ts) to write featured_listings
# after a Razorpay payment has been signature-verified. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — leave blank for local development. Every payment code path checks
# isRazorpayConfigured() first, so the app runs fine without these and simply
# shows a "payments not configured" notice on the feature/promote flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public site URL, used for building absolute links (e.g. Razorpay callback pages).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
